# Copy to backend/.env for local development. Never commit real keys.
DATABASE_URL=postgresql+psycopg://localhost:5432/aicommerce
SECRET_KEY=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
RESEARCH_PROVIDER=anthropic_web_search   # anthropic_web_search | tavily | brave
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
MAX_SEARCHES_PER_STEP=5
MAX_RESEARCH_COST_USD=5
SIGNUP_ENABLED=false
ALLOWED_SIGNUP_EMAILS=
